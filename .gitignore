repos/
*.pyc
__pycache__/
customers/*/db/connections.json
# Ticket workspaces: keep only state.json (reasoning examples); drop the bulk.
# NOTE: gitignore has no trailing-comment support — patterns must stand alone.
tickets/*/repos/
tickets/*/logs/
# pulled OCI live config — regenerable, raw client config, keep out of git
tickets/*/live-config/
tickets/*/live-config-staging/
# newticket.sh smoke-test junk
tickets/SUP-9001/
tickets/SUP-9002/
.DS_Store
.claude/settings.local.json

# Generated lineage artifacts (regenerable via tooling/lineage/regen.sh) — keep code, not 40MB of JSON/DB
customers/*/lineage/*.db
customers/*/lineage/unified_graph.json
customers/*/lineage/pivot_graph.json
customers/*/lineage/*.html
tooling/lineage-viz/workspaces/
unified_load.py
# timestamped lineage snapshots taken before a regen — same regenerable artifacts, different folder name
customers/*/lineage.bak_*/

# Personal learning artifacts — your practice data, regenerable, keep out of git
tooling/learning/deck.json
tooling/learning/calibration_log.jsonl
tooling/learning/skill_ledger.jsonl
customers/*/lineage/catalog.db

# knowledge full-text index (regenerable via tooling/knowledge/index_build.py)
knowledge/knowledge_fts.db

# runtime members cache (regenerable from the DB)
tooling/validation/.members_cache/

# local virtualenv, don't commit third-party packages
tooling/validation/ui/.venv/

# Validation Studio's local config clone + pulled OCI overlay — regenerable
# via tooling/validation/config_sync.py, same reasoning as tickets/*/live-config/
customers/*/config/
